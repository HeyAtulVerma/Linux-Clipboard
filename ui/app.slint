// MagicToys — Clipboard/Emoji Drawer Window
// Compact floating panel with Ople brand palette.

import { ScrollView } from "std-widgets.slint";

import { SlintClipItem, SlintEmojiItem, SlintEmojiRow } from "./types.slint";
import { HistoryCard } from "./history_card.slint";
import { EmojiPanel } from "./emoji_panel.slint";
import { MainWindow } from "./main_window.slint";
import { SnippingOverlay } from "./snipping_overlay.slint";
import { ColorPickerOverlay } from "./color_picker_overlay.slint";
import { ColorEditorWindow } from "./color_editor.slint";

export { MainWindow, SnippingOverlay, ColorPickerOverlay, ColorEditorWindow }

export component AppWindow inherits Window {
    title: "MagicToys";
    icon: @image-url("../icon.png");


    default-font-family: "Cantarell, Inter, Roboto, 'Noto Sans', Ubuntu, sans-serif";
    default-font-size: 14px;

    width: 360px;
    height: 480px;
    always-on-top: true;
    background: bg-color;
    no-frame: true;


    // Callbacks to Rust backend
    callback paste-item(string);
    callback delete-item(string);
    callback toggle-pin(string);
    callback clear-history();
    callback record-emoji(string);
    callback search-changed(string);
    callback emoji-category-changed(int);
    callback change-theme(string);
    callback toggle-clipboard(bool);
    callback toggle-emoji(bool);
    callback toggle-ocr(bool);
    callback open-preferences();
    callback close-window();
    callback fix-single-shortcut(string);

    // Data models
    in-out property <[SlintClipItem]> clips: [];
    in-out property <[SlintEmojiRow]> emoji_rows: [];
    in-out property <int> selected_index: 0;
    in-out property <int> active-tab: 0;
    in-out property <int> active-emoji-category: 0;
    in-out property <bool> is-dark: true;
    in-out property <bool> enable-clipboard: false;
    in-out property <bool> enable-emoji: false;
    in-out property <bool> enable-ocr: false;

    in-out property <string> search-placeholder: "Search clipboard...";
    in-out property <string> search-text: "";
    in-out property <string> theme-mode: "system";
    in-out property <string> accent-hex: "#f97316";

    // Design tokens — high-contrast crisp palette
    property <color> bg-color:      is-dark ? #121212 : #f8f9fa;
    property <color> border-color:  is-dark ? #282828 : #e2e8f0;
    property <color> text-color:    is-dark ? #ffffff : #0f172a;
    property <color> text-secondary: is-dark ? #94a3b8 : #64748b;
    property <color> card-bg:       is-dark ? #1c1c1c : #ffffff;
    property <color> card-hover-bg: is-dark ? #262626 : #f1f5f9;
    property <color> pinned-color:  is-dark ? #f97316 : #ea580c;
    property <color> pinned-bg:     is-dark ? rgba(249, 115, 22, 0.12) : rgba(249, 115, 22, 0.08);

    // Accent — resolved from stored hex
    property <color> accent: accent-hex == "#f97316" ? #f97316
                           : accent-hex == "#3b82f6" ? #3b82f6
                           : accent-hex == "#8b5cf6" ? #8b5cf6
                           : accent-hex == "#22c55e" ? #22c55e
                           : accent-hex == "#f43f5e" ? #f43f5e
                           : accent-hex == "#06b6d4" ? #06b6d4
                           : #f97316;

    in-out property <length> scroll-y: 0px;

    function scroll-to-index(idx: int) {
        let has-pinned: bool = root.clips.length > 0 && root.clips[0].pinned;
        let is-past-pinned: bool = idx > 0 && !root.clips[idx].pinned && has-pinned;
        let item-top: length = idx * 76px + (has-pinned ? (is-past-pinned ? 44px : 22px) : 22px);
        let item-bottom: length = item-top + 70px;
        let view-top = -scroll-y;
        let view-bottom = -scroll-y + 330px;

        if (item-top < view-top) {
            scroll-y = -item-top;
        } else if (item-bottom > view-bottom) {
            scroll-y = -(item-bottom - 330px);
        }
    }

    changed selected_index => {
        root.scroll-to-index(self.selected_index);
    }

    public function reset-state() {
        root.search-text = "";
        root.selected_index = 0;
        root.scroll-y = 0px;
        root.active-tab = 0;
        root.active-emoji-category = 0;
        root.search-placeholder = "Search history...";
        root.search-changed("");
    }

    FocusScope {
        width: 100%;
        height: 100%;

        Rectangle {
            width: 100%;
            height: 100%;
            background: bg-color;
            border-radius: 10px;
            border-width: 1px;
            border-color: border-color;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                // ── Header ──────────────────────────────────
                HorizontalLayout {
                    z: 10;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Image {
                            source: @image-url("../icon.png");
                            width: 28px;
                            height: 28px;
                        }

                        Text {
                            text: "MagicToys";
                            font-size: 16px;
                            font-weight: 700;
                            color: text-color;
                            vertical-alignment: center;
                        }
                    }


                    HorizontalLayout {
                        spacing: 6px;

                        // Clear all
                        clear-all-btn := TouchArea {
                            width: 26px;
                            height: 26px;
                            clicked => { root.clear-history(); }
                            Rectangle {
                                background: clear-all-btn.has-hover ? rgba(239, 68, 68, 0.12) : transparent;
                                border-radius: 5px;
                                Text {
                                    text: "🗑";
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Preferences
                        pref-btn := TouchArea {
                            width: 26px;
                            height: 26px;
                            clicked => { root.open-preferences(); }
                            Rectangle {
                                background: pref-btn.has-hover ? card-hover-bg : transparent;
                                border-radius: 5px;
                                Text {
                                    text: "⚙";
                                    font-size: 16px;
                                    color: text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Close
                        close-btn := TouchArea {
                            width: 26px;
                            height: 26px;
                            clicked => { root.close-window(); }
                            Rectangle {
                                background: close-btn.has-hover ? #e81123 : transparent;
                                border-radius: 5px;
                                Text {
                                    text: "✕";
                                    font-size: 14px;
                                    color: close-btn.has-hover ? #ffffff : text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Tab Bar ─────────────────────────────────
                HorizontalLayout {
                    height: 34px;
                    spacing: 4px;

                    if (enable-clipboard) : TouchArea {
                        clicked => {
                            active-tab = 0;
                            search-placeholder = "Search history...";
                            root.search-text = "";
                            root.search-changed("");
                        }
                        Rectangle {
                            background: active-tab == 0 ? card-bg : (parent.has-hover ? card-hover-bg : bg-color);
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: active-tab == 0 ? accent : border-color;
                            Text {
                                text: "History";
                                font-size: 13px;
                                font-weight: 600;
                                color: active-tab == 0 ? accent : text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if (enable-emoji) : TouchArea {
                        clicked => {
                            active-tab = 1;
                            search-placeholder = "Search emojis...";
                            root.search-text = "";
                            root.search-changed("");
                            root.active-emoji-category = 0;
                            root.emoji-category-changed(0);
                        }
                        Rectangle {
                            background: active-tab == 1 ? card-bg : (parent.has-hover ? card-hover-bg : bg-color);
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: active-tab == 1 ? accent : border-color;
                            Text {
                                text: "Emoji";
                                font-size: 13px;
                                font-weight: 600;
                                color: active-tab == 1 ? accent : text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── Search Bar ──────────────────────────────
                Rectangle {
                    height: 36px;
                    background: card-bg;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: border-color;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: stretch;

                        search-input := TextInput {
                            text <=> root.search-text;
                            font-size: 14px;
                            color: text-color;
                            single-line: true;
                            vertical-alignment: center;

                            init => { self.focus(); }

                            edited => { root.search-changed(self.text); }

                            key-pressed(event) => {
                                if (event.text == Key.DownArrow) {
                                    root.selected_index = Math.min(root.selected_index + 1, root.clips.length - 1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.selected_index = Math.max(root.selected_index - 1, 0);
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    if (root.clips.length > 0 && root.selected_index >= 0 && root.selected_index < root.clips.length) {
                                        root.paste-item(root.clips[root.selected_index].id);
                                    }
                                    return accept;
                                }
                                reject
                            }

                            if (self.text == "") : Text {
                                text: search-placeholder;
                                font-size: 14px;
                                color: text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── Clipboard History ────────────────────────
                if (active-tab == 0 && enable-clipboard) : ScrollView {
                    viewport-y <=> root.scroll-y;

                    VerticalLayout {
                        alignment: start;
                        spacing: 5px;
                        padding-right: 4px;
                        padding-bottom: 8px;

                        if (clips.length == 0) : VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            height: 200px;
                            Text {
                                text: "📋";
                                font-size: 32px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Clipboard history is empty";
                                font-size: 14px;
                                font-weight: 600;

                                color: root.text-secondary;
                                horizontal-alignment: center;
                            }
                        }

                        for clip[idx] in clips : VerticalLayout {
                            spacing: 3px;

                            if (idx == 0 && clip.pinned) : HorizontalLayout {
                                padding-left: 4px;
                                padding-top: 2px;
                                Text {
                                    text: "Pinned";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: pinned-color;
                                }
                            }

                            if (!clip.pinned && (idx == 0 || root.clips[idx - 1].pinned)) : HorizontalLayout {
                                padding-left: 4px;
                                padding-top: 4px;
                                Text {
                                    text: "Recent";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: text-secondary;
                                }
                            }

                            HistoryCard {
                                item: clip;
                                is-selected: root.selected_index == idx;
                                bg-color: root.bg-color;
                                border-color: root.border-color;
                                text-color: root.text-color;
                                text-secondary: root.text-secondary;
                                accent-color: root.accent;
                                card-bg: root.card-bg;
                                card-hover-bg: root.card-hover-bg;
                                pinned-bg: root.pinned-bg;

                                paste-item(id) => { root.paste-item(id); }
                                toggle-pin(id) => { root.toggle-pin(id); }
                                delete-item(id) => { root.delete-item(id); }
                            }
                        }
                    }
                }

                // ── Emoji Panel ──────────────────────────────
                if (active-tab == 1 && enable-emoji) : EmojiPanel {
                    active-emoji-category <=> root.active-emoji-category;
                    emoji-rows: root.emoji-rows;
                    card-bg: root.card-bg;
                    card-hover-bg: root.card-hover-bg;
                    border-color: root.border-color;
                    accent-color: root.accent;

                    emoji-category-changed(cat) => { root.emoji-category-changed(cat); }
                    record-emoji(emoji) => { root.record-emoji(emoji); }
                }

                // ── Tools disabled fallback ──────────────────
                if (!enable-clipboard && !enable-emoji) : VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    height: 200px;

                    Text {
                        text: "Tools Disabled";
                        font-size: 14px;
                        font-weight: 700;
                        color: root.text-color;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Enable tools in MagicToys settings";
                        font-size: 11px;
                        color: root.text-secondary;
                        horizontal-alignment: center;
                    }
                    open-pref := TouchArea {
                        width: 120px;
                        height: 30px;
                        clicked => { root.open-preferences(); }
                        Rectangle {
                            background: open-pref.has-hover ? card-hover-bg : accent;
                            border-radius: 6px;
                            Text {
                                text: "Open Settings";
                                color: open-pref.has-hover ? text-color : #ffffff;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
