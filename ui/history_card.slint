// MagicToys HistoryCard component
// Renders individual clipboard history items (text/rich text preview, images, pin/delete actions)
// with crisp, unblurred subpixel text rendering.

import { SlintClipItem } from "./types.slint";

export component HistoryCard inherits TouchArea {
    in-out property <SlintClipItem> item;
    in-out property <bool> is-selected;
    
    // Theme colors passed from parent
    in property <color> bg-color;
    in property <color> border-color;
    in property <color> text-color;
    in property <color> text-secondary;
    in property <color> accent-color;
    in property <color> card-bg;
    in property <color> card-hover-bg;
    in property <color> pinned-bg;
    
    // Callbacks
    callback paste-item(string);
    callback toggle-pin(string);
    callback delete-item(string);

    height: 72px;
    clicked => { paste-item(item.id); }

    Rectangle {
        background: is-selected ? card-hover-bg : (parent.has-hover ? card-hover-bg : (item.pinned ? pinned-bg : card-bg));
        border-radius: 8px;
        border-width: is-selected ? 1.5px : 1px;
        border-color: is-selected ? accent-color : border-color;
        
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 10px;
            
            if (item.item_type == "Image") : Image {
                source: item.image;
                width: 80px;
                height: 54px;
                image-fit: contain;
            }

            if (item.is_color) : Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 8px;
                background: item.color_preview;
                border-width: 1.5px;
                border-color: #ffffff33;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000044;
            }
            
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                
                // Crisp high-contrast preview text
                Text {
                    text: item.preview;
                    font-size: 14px;
                    font-weight: 500;
                    color: text-color;
                    overflow: elide;
                }

                Text {
                    text: item.timestamp_str;
                    font-size: 12px;
                    color: text-secondary;
                }
            }
           
            // Row Action buttons (Pin & Delete)
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    width: 52px;
                    
                    // Pin Button
                    TouchArea {
                        width: 22px;
                        height: 22px;
                        clicked => { toggle-pin(item.id); }
                        Text {
                            text: item.pinned ? "📌" : "📍";
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Delete Button
                    TouchArea {
                        width: 22px;
                        height: 22px;
                        clicked => { delete-item(item.id); }
                        Text {
                            text: "✕";
                            font-size: 13px;
                            color: text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

        }
    }
}
