// MagicToys — Main Settings Window
// Clean PowerToys-inspired layout with Ople brand palette.

import { ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "MagicToys";
    icon: @image-url("../icon.png");


    preferred-width: 800px;
    preferred-height: 560px;
    background: bg-color;

    forward-focus: modal-focus-scope;

    modal-focus-scope := FocusScope {
        key-pressed(event) => {
            if (!root.is-shortcut-modal-open) {
                return reject;
            }
            if (event.text == Key.Escape) {
                root.close-shortcut-modal();
                return accept;
            }
            if (event.text == Key.Return && root.active-modal-can-apply) {
                root.apply-modal-shortcut(root.active-modal-tool, root.active-modal-current-key);
                return accept;
            }
            root.handle-shortcut-key-press(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta
            );
            accept
        }
    }

    // Active section: 0=General, 1=Clipboard, 2=Emoji, 3=Text Extractor
    in-out property <int> active-section: 0;

    // Core properties (tools default to toggled off per user requirement)
    in-out property <string> theme-mode: "system";
    in-out property <bool> is-dark: true;
    in-out property <bool> enable-clipboard: false;
    in-out property <bool> enable-emoji: false;
    in-out property <bool> enable-ocr: false;
    in-out property <bool> enable-color-picker: false;

    in-out property <int> history-count: 0;
    in-out property <bool> clip-has-conflict: false;
    in-out property <bool> emoji-has-conflict: false;
    in-out property <bool> ocr-has-conflict: false;
    in-out property <bool> color-picker-has-conflict: false;
    in-out property <bool> color-picker-show-editor: true;
    in-out property <bool> color-picker-auto-copy: true;
    in-out property <string> color-picker-default-format: "HEX";
    in-out property <string> accent-hex: "#f97316";

    // Custom Shortcut properties
    in-out property <string> clip-shortcut: "Alt+V";
    in-out property <string> emoji-shortcut: "Alt+.";
    in-out property <string> ocr-shortcut: "Alt+Shift+T";
    in-out property <string> color-picker-shortcut: "Alt+Shift+C";

    in-out property <bool> is-clip-customized: false;
    in-out property <bool> is-emoji-customized: false;
    in-out property <bool> is-ocr-customized: false;
    in-out property <bool> is-color-customized: false;

    // Modal popup state
    in-out property <bool> is-shortcut-modal-open: false;
    in-out property <string> active-modal-tool: "";
    in-out property <string> active-modal-tool-title: "";
    in-out property <string> active-modal-current-key: "";
    in-out property <bool> active-modal-is-available: true;
    in-out property <string> active-modal-status-text: "Available";
    in-out property <bool> active-modal-can-apply: true;
    in-out property <bool> active-modal-show-override: false;

    // Design tokens — Ople black palette
    property <color> bg-color:       is-dark ? #0a0a0a : #f5f5f5;
    property <color> sidebar-bg:     is-dark ? #111111 : #ebebeb;
    property <color> card-bg:        is-dark ? #161616 : #ffffff;
    property <color> card-hover-bg:  is-dark ? #1e1e1e : #f0f0f0;
    property <color> text-color:     is-dark ? #f5f5f5 : #111111;
    property <color> text-muted:     is-dark ? #737373 : #737373;
    property <color> border-color:   is-dark ? #1f1f1f : #e0e0e0;
    property <color> danger-color:   #ef4444;

    // Accent — resolved from hex string (default Ople orange, user-switchable)
    property <color> accent: accent-hex == "#f97316" ? #f97316
        : accent-hex == "#3b82f6" ? #3b82f6
        : accent-hex == "#8b5cf6" ? #8b5cf6
        : accent-hex == "#22c55e" ? #22c55e
        : accent-hex == "#f43f5e" ? #f43f5e
        : accent-hex == "#06b6d4" ? #06b6d4
        : #f97316;

    // Callbacks
    callback change-theme(string);
    callback change-accent(string);
    callback toggle-clipboard(bool);
    callback toggle-emoji(bool);
    callback toggle-ocr(bool);
    callback toggle-color-picker(bool);
    callback toggle-color-editor-window(bool);
    callback toggle-color-auto-copy(bool);
    callback set-color-default-format(string);
    callback fix-single-shortcut(string);
    callback clear-history();
    callback open-url(string);

    callback open-shortcut-modal(string);
    callback close-shortcut-modal();
    callback test-shortcut-input(string, string);
    callback handle-shortcut-key-press(string, bool, bool, bool, bool);
    callback apply-modal-shortcut(string, string);
    callback reset-tool-shortcut(string);


    // ── Root layout ──────────────────────────────────────
    HorizontalLayout {
        spacing: 0;

        // ── SIDEBAR ─────────────────────────────────────
        Rectangle {
            width: 200px;
            background: sidebar-bg;
            border-width: 1px;
            border-color: border-color;
            // Visible only on the right edge (simulate right-border-only)


            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 16px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;

                // Brand header
                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 20px;
                    padding-left: 4px;

                    Image {
                        source: @image-url("../icon.png");
                        width: 44px;
                        height: 44px;
                    }



                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "MagicToys";
                            font-size: 15px;
                            font-weight: 700;
                            color: text-color;
                        }

                        Text {
                            text: "by Ople";
                            font-size: 12px;
                            color: accent;
                        }
                    }
                }

                // NAV ITEM helper — General
                nav-general := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 0; }
                    Rectangle {
                        background: root.active-section == 0 ? accent : (nav-general.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "General";
                                font-size: 14px;
                                font-weight: root.active-section == 0 ? 700 : 400;
                                color: root.active-section == 0 ? #ffffff : text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                nav-clipboard := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 1; }
                    Rectangle {
                        background: root.active-section == 1 ? accent : (nav-clipboard.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "Clipboard";
                                font-size: 14px;
                                font-weight: root.active-section == 1 ? 700 : 400;
                                color: root.active-section == 1 ? #ffffff : text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                nav-emoji := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 2; }
                    Rectangle {
                        background: root.active-section == 2 ? accent : (nav-emoji.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "Emoji Picker";
                                font-size: 14px;
                                font-weight: root.active-section == 2 ? 700 : 400;
                                color: root.active-section == 2 ? #ffffff : text-color;

                                vertical-alignment: center;
                            }
                        }
                    }
                }

                nav-ocr := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 3; }
                    Rectangle {
                        background: root.active-section == 3 ? accent : (nav-ocr.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "Text Extractor";
                                font-size: 14px;
                                font-weight: root.active-section == 3 ? 700 : 400;
                                color: root.active-section == 3 ? #ffffff : text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                nav-color := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 4; }
                    Rectangle {
                        background: root.active-section == 4 ? accent : (nav-color.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "Color Picker";
                                font-size: 14px;
                                font-weight: root.active-section == 4 ? 700 : 400;
                                color: root.active-section == 4 ? #ffffff : text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Spacer pushes version badge down to stick as a footer
                Rectangle {
                    vertical-stretch: 1;
                }

                // Version badge: v0.0.41 with green Beta pill (sticking to bottom footer)
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    height: 24px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "v0.0.5";
                            font-size: 13px;
                            font-weight: 500;
                            color: text-muted;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        background: rgba(34, 197, 94, 0.15);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: rgba(34, 197, 94, 0.3);
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Beta";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #22c55e;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

            }

        }

        // ── CONTENT AREA ─────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0;

            // Topbar — section title only; OS provides the window close/min/max buttons
            Rectangle {
                height: 46px;
                background: card-bg;
                border-width: 1px;
                border-color: border-color;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;

                    Text {
                        text: root.active-section == 0 ? "General"
                            : root.active-section == 1 ? "Clipboard History"
                            : root.active-section == 2 ? "Emoji Picker"
                            : "Text Extractor (OCR)";
                        font-size: 15px;
                        font-weight: 600;
                        color: text-color;
                        vertical-alignment: center;
                    }
                }
            }

            // Scrollable content
            ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;

                    // ═══════════════════════════════
                    // SECTION 0: GENERAL
                    // ═══════════════════════════════
                    if (root.active-section == 0): VerticalLayout {
                        spacing: 12px;

                        // Theme card
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                // Row: label + pill selector
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Appearance";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Choose light, dark, or follow system theme";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 30px;

                                        TouchArea {
                                            width: 64px;
                                            clicked => { root.change-theme("system"); }
                                            Rectangle {
                                                background: root.theme-mode == "system" ? accent : card-hover-bg;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: root.theme-mode == "system" ? accent : border-color;
                                                Text {
                                                    text: "Auto";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: root.theme-mode == "system" ? #ffffff : text-muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            width: 56px;
                                            clicked => { root.change-theme("dark"); }
                                            Rectangle {
                                                background: root.theme-mode == "dark" ? accent : card-hover-bg;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: root.theme-mode == "dark" ? accent : border-color;
                                                Text {
                                                    text: "Dark";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: root.theme-mode == "dark" ? #ffffff : text-muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            width: 56px;
                                            clicked => { root.change-theme("light"); }
                                            Rectangle {
                                                background: root.theme-mode == "light" ? accent : card-hover-bg;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: root.theme-mode == "light" ? accent : border-color;
                                                Text {
                                                    text: "Light";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: root.theme-mode == "light" ? #ffffff : text-muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Divider
                                Rectangle {
                                    height: 1px;
                                    background: border-color;
                                }

                                // Row: Accent color swatches
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Accent Color";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Active color used across the interface";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        // Orange (Ople default)
                                        swatch-orange := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#f97316"); }
                                            Rectangle {
                                                background: #f97316;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#f97316" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Blue
                                        swatch-blue := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#3b82f6"); }
                                            Rectangle {
                                                background: #3b82f6;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#3b82f6" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Violet
                                        swatch-violet := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#8b5cf6"); }
                                            Rectangle {
                                                background: #8b5cf6;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#8b5cf6" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Green
                                        swatch-green := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#22c55e"); }
                                            Rectangle {
                                                background: #22c55e;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#22c55e" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Rose
                                        swatch-rose := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#f43f5e"); }
                                            Rectangle {
                                                background: #f43f5e;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#f43f5e" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Cyan
                                        swatch-cyan := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#06b6d4"); }
                                            Rectangle {
                                                background: #06b6d4;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#06b6d4" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Flexible spacer positioning the About card as a footer card
                        Rectangle {
                            height: 220px;
                        }


                        // About card: MagicToys Open-Source project by Ople with Contribute button
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;


                            HorizontalLayout {
                                padding: 16px;
                                spacing: 14px;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: "MagicToys";
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: text-color;
                                    }

                                    Text {
                                        text: "Open-Source project by Ople";
                                        font-size: 13px;
                                        color: text-muted;
                                    }
                                }

                                contribute-btn := TouchArea {
                                    width: 108px;
                                    height: 32px;
                                    clicked => { root.open-url("https://github.com"); }

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: contribute-btn.has-hover ? accent.darker(0.1) : accent;
                                        border-radius: 6px;

                                        HorizontalLayout {
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Contribute ↗";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                    }



                    // ═══════════════════════════════
                    // SECTION 1: CLIPBOARD
                    // ═══════════════════════════════
                    if (root.active-section == 1): VerticalLayout {
                        spacing: 12px;

                        // Tool enable card (with conflict border)
                        Rectangle {
                            background: (root.enable-clipboard && root.clip-has-conflict) ? (is-dark ? #1a0d0d : #fff5f5) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-clipboard && root.clip-has-conflict) ? 1.5px : 1px;
                            border-color: (root.enable-clipboard && root.clip-has-conflict) ? danger-color : border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                // Toggle row
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Clipboard History";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Monitor clipboard changes — shortcut: Alt + V";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    // Toggle switch
                                    toggle-clip := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.enable-clipboard = !root.enable-clipboard;
                                            root.toggle-clipboard(root.enable-clipboard);
                                        }
                                        Rectangle {
                                            background: root.enable-clipboard ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.enable-clipboard ? accent : border-color;
                                            Rectangle {
                                                x: root.enable-clipboard ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                // Shortcut badge row
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Global Shortcut";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Press to open Clipboard History from anywhere";
                                            font-size: 12px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;

                                        // Restore default button
                                        if (root.is-clip-customized): VerticalLayout {
                                            alignment: center;
                                            btn-reset-clip := TouchArea {
                                                width: 28px;
                                                height: 28px;
                                                clicked => { root.reset-tool-shortcut("toggle"); }
                                                Rectangle {
                                                    background: btn-reset-clip.has-hover ? card-hover-bg : transparent;
                                                    border-radius: 14px;
                                                    border-width: 1px;
                                                    border-color: border-color;
                                                    Text {
                                                        text: "↺";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: text-muted;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Editable shortcut square box
                                        btn-edit-clip := TouchArea {
                                            clicked => { root.open-shortcut-modal("toggle"); }
                                            Rectangle {
                                                background: btn-edit-clip.has-hover ? card-hover-bg : (is-dark ? #222222 : #e8e8e8);
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: (root.enable-clipboard && root.clip-has-conflict) ? danger-color : (btn-edit-clip.has-hover ? accent : border-color);
                                                height: 28px;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;

                                                    Text {
                                                        text: root.clip-shortcut;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: accent;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: "✎";
                                                        font-size: 13px;
                                                        color: text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Conflict warning — only if conflict
                                if (root.enable-clipboard && root.clip-has-conflict): Text {
                                    text: "⚠ Shortcut conflict detected with system keybindings";
                                    font-size: 12px;
                                    color: danger-color;
                                }
                            }
                        }

                        // History storage card
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Saved Items";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: text-color;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.history-count + " clips";
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: accent;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: border-color;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Clear History";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: danger-color;
                                        }

                                        Text {
                                            text: "Permanently delete all stored clips";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    clr-btn := TouchArea {
                                        width: 76px;
                                        height: 28px;
                                        clicked => { root.clear-history(); }
                                        Rectangle {
                                            background: clr-btn.has-hover ? danger-color : card-hover-bg;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: clr-btn.has-hover ? danger-color : danger-color;
                                            Text {
                                                text: "Clear All";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: clr-btn.has-hover ? #ffffff : danger-color;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ═══════════════════════════════
                    // SECTION 2: EMOJI
                    // ═══════════════════════════════
                    if (root.active-section == 2): VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            background: (root.enable-emoji && root.emoji-has-conflict) ? (is-dark ? #1a0d0d : #fff5f5) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-emoji && root.emoji-has-conflict) ? 1.5px : 1px;
                            border-color: (root.enable-emoji && root.emoji-has-conflict) ? danger-color : border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Emoji Picker";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Enable emoji picker tab — shortcut: Alt + .";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    toggle-emoji-sw := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.enable-emoji = !root.enable-emoji;
                                            root.toggle-emoji(root.enable-emoji);
                                        }
                                        Rectangle {
                                            background: root.enable-emoji ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.enable-emoji ? accent : border-color;
                                            Rectangle {
                                                x: root.enable-emoji ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                // Shortcut badge row
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Global Shortcut";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Press to open Emoji Picker from anywhere";
                                            font-size: 12px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;

                                        // Restore default button
                                        if (root.is-emoji-customized): VerticalLayout {
                                            alignment: center;
                                            btn-reset-emoji := TouchArea {
                                                width: 28px;
                                                height: 28px;
                                                clicked => { root.reset-tool-shortcut("emoji"); }
                                                Rectangle {
                                                    background: btn-reset-emoji.has-hover ? card-hover-bg : transparent;
                                                    border-radius: 14px;
                                                    border-width: 1px;
                                                    border-color: border-color;
                                                    Text {
                                                        text: "↺";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: text-muted;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Editable shortcut square box
                                        btn-edit-emoji := TouchArea {
                                            clicked => { root.open-shortcut-modal("emoji"); }
                                            Rectangle {
                                                background: btn-edit-emoji.has-hover ? card-hover-bg : (is-dark ? #222222 : #e8e8e8);
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: (root.enable-emoji && root.emoji-has-conflict) ? danger-color : (btn-edit-emoji.has-hover ? accent : border-color);
                                                height: 28px;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;

                                                    Text {
                                                        text: root.emoji-shortcut;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: accent;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: "✎";
                                                        font-size: 13px;
                                                        color: text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Conflict warning — only if conflict
                                if (root.enable-emoji && root.emoji-has-conflict): Text {
                                    text: "⚠ Shortcut conflict detected with system keybindings";
                                    font-size: 12px;
                                    color: danger-color;
                                }
                            }
                        }
                    }

                    // ═══════════════════════════════
                    // SECTION 3: TEXT EXTRACTOR
                    // ═══════════════════════════════
                    if (root.active-section == 3): VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            background: (root.enable-ocr && root.ocr-has-conflict) ? (is-dark ? #1a0d0d : #fff5f5) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-ocr && root.ocr-has-conflict) ? 1.5px : 1px;
                            border-color: (root.enable-ocr && root.ocr-has-conflict) ? danger-color : border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Text Extractor (OCR)";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Capture text from screen region — shortcut: Alt + Shift + T";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    toggle-ocr-sw := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.enable-ocr = !root.enable-ocr;
                                            root.toggle-ocr(root.enable-ocr);
                                        }
                                        Rectangle {
                                            background: root.enable-ocr ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.enable-ocr ? accent : border-color;
                                            Rectangle {
                                                x: root.enable-ocr ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                // Shortcut badge row
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Global Shortcut";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Press to capture screen text from anywhere";
                                            font-size: 12px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;

                                        // Restore default button
                                        if (root.is-ocr-customized): VerticalLayout {
                                            alignment: center;
                                            btn-reset-ocr := TouchArea {
                                                width: 28px;
                                                height: 28px;
                                                clicked => { root.reset-tool-shortcut("ocr"); }
                                                Rectangle {
                                                    background: btn-reset-ocr.has-hover ? card-hover-bg : transparent;
                                                    border-radius: 14px;
                                                    border-width: 1px;
                                                    border-color: border-color;
                                                    Text {
                                                        text: "↺";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: text-muted;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Editable shortcut square box
                                        btn-edit-ocr := TouchArea {
                                            clicked => { root.open-shortcut-modal("ocr"); }
                                            Rectangle {
                                                background: btn-edit-ocr.has-hover ? card-hover-bg : (is-dark ? #222222 : #e8e8e8);
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: (root.enable-ocr && root.ocr-has-conflict) ? danger-color : (btn-edit-ocr.has-hover ? accent : border-color);
                                                height: 28px;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;

                                                    Text {
                                                        text: root.ocr-shortcut;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: accent;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: "✎";
                                                        font-size: 13px;
                                                        color: text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Conflict warning — only if conflict
                                if (root.enable-ocr && root.ocr-has-conflict): Text {
                                    text: "⚠ Shortcut conflict detected with system keybindings";
                                    font-size: 12px;
                                    color: danger-color;
                                }
                            }
                        }
                    }

                    // ═══════════════════════════════
                    // SECTION 4: COLOR PICKER
                    // ═══════════════════════════════
                    if (root.active-section == 4): VerticalLayout {
                        spacing: 14px;

                        // Card 1: Master Enable & Shortcut
                        Rectangle {
                            background: (root.enable-color-picker && root.color-picker-has-conflict) ? (is-dark ? #1a0d0d : #fff5f5) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-color-picker && root.color-picker-has-conflict) ? 1.5px : 1px;
                            border-color: (root.enable-color-picker && root.color-picker-has-conflict) ? danger-color : border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Color Picker";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Magnify and sample pixel colors from anywhere — shortcut: Alt + Shift + C";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    toggle-color-sw := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.enable-color-picker = !root.enable-color-picker;
                                            root.toggle-color-picker(root.enable-color-picker);
                                        }
                                        Rectangle {
                                            background: root.enable-color-picker ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.enable-color-picker ? accent : border-color;
                                            Rectangle {
                                                x: root.enable-color-picker ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                // Shortcut badge row
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Global Shortcut";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Press to inspect pixel colors from anywhere";
                                            font-size: 12px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;

                                        // Restore default button
                                        if (root.is-color-customized): VerticalLayout {
                                            alignment: center;
                                            btn-reset-color := TouchArea {
                                                width: 28px;
                                                height: 28px;
                                                clicked => { root.reset-tool-shortcut("color"); }
                                                Rectangle {
                                                    background: btn-reset-color.has-hover ? card-hover-bg : transparent;
                                                    border-radius: 14px;
                                                    border-width: 1px;
                                                    border-color: border-color;
                                                    Text {
                                                        text: "↺";
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        color: text-muted;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Editable shortcut square box
                                        btn-edit-color := TouchArea {
                                            clicked => { root.open-shortcut-modal("color"); }
                                            Rectangle {
                                                background: btn-edit-color.has-hover ? card-hover-bg : (is-dark ? #222222 : #e8e8e8);
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: (root.enable-color-picker && root.color-picker-has-conflict) ? danger-color : (btn-edit-color.has-hover ? accent : border-color);
                                                height: 28px;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;

                                                    Text {
                                                        text: root.color-picker-shortcut;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: accent;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: "✎";
                                                        font-size: 13px;
                                                        color: text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Conflict warning — only if conflict
                                if (root.enable-color-picker && root.color-picker-has-conflict): Text {
                                    text: "⚠ Shortcut conflict detected with system keybindings";
                                    font-size: 12px;
                                    color: danger-color;
                                }
                            }
                        }

                        // Card 2: Color Picker Behaviors & Instant Copy Settings
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 16px;

                                Text {
                                    text: "Picking Behaviors";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: text-color;
                                }

                                // Setting: Show color editor after picking
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Show Color Inspector Window";
                                            font-size: 13px;
                                            font-weight: 500;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Opens the multi-format color details window after clicking a pixel";
                                            font-size: 12px;
                                            color: text-muted;
                                        }
                                    }

                                    toggle-editor-sw := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.color-picker-show-editor = !root.color-picker-show-editor;
                                            root.toggle-color-editor-window(root.color-picker-show-editor);
                                        }
                                        Rectangle {
                                            background: root.color-picker-show-editor ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.color-picker-show-editor ? accent : border-color;
                                            Rectangle {
                                                x: root.color-picker-show-editor ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: border-color; }

                                // Setting: Copy color instantly on pick
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Copy Color Instantly";
                                            font-size: 13px;
                                            font-weight: 500;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Copies the selected color code to clipboard immediately on click";
                                            font-size: 12px;
                                            color: text-muted;
                                        }
                                    }

                                    toggle-copy-sw := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.color-picker-auto-copy = !root.color-picker-auto-copy;
                                            root.toggle-color-auto-copy(root.color-picker-auto-copy);
                                        }
                                        Rectangle {
                                            background: root.color-picker-auto-copy ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.color-picker-auto-copy ? accent : border-color;
                                            Rectangle {
                                                x: root.color-picker-auto-copy ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: border-color; }

                                // Setting: Default Color Format Dropdown / Selector
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Default Color Format";
                                            font-size: 13px;
                                            font-weight: 500;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "The color format copied automatically to clipboard";
                                            font-size: 12px;
                                            color: text-muted;
                                        }
                                    }

                                    // Format selector pills (HEX, RGB, HSL, HSV, CMYK)
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 28px;

                                        for fmt in ["HEX", "RGB", "HSL", "HSV", "CMYK"] : Rectangle {
                                            background: root.color-picker-default-format == fmt ? accent : card-hover-bg;
                                            border-radius: 5px;
                                            border-width: 1px;
                                            border-color: root.color-picker-default-format == fmt ? accent : border-color;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                alignment: center;
                                                Text {
                                                    text: fmt;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: root.color-picker-default-format == fmt ? #ffffff : text-color;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.color-picker-default-format = fmt;
                                                    root.set-color-default-format(fmt);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Full Screen Dimmed Modal Backdrop ─────────────────
    if (root.is-shortcut-modal-open): modal-backdrop := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000a0;

        // Catch clicks to dismiss if clicking outside the card
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.close-shortcut-modal(); }
        }

        // ── Centered Modal Square ──────────────────────────
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: 250px;
            background: is-dark ? #181818 : #ffffff;
            border-radius: 14px;
            border-width: 1px;
            border-color: is-dark ? #333333 : #e0e0e0;
            clip: true;

            // Block clicks from hitting backdrop
            TouchArea {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                padding: 16px;
                alignment: space-between;

                // Header Row: Tick at Top-Left, Tool Name in Middle, Close at Top-Right
                HorizontalLayout {
                    alignment: space-between;
                    height: 32px;

                    // Tick Button (Top-Left) — Dark / Black style without green
                    btn-modal-tick := TouchArea {
                        width: 32px;
                        height: 32px;
                        enabled: root.active-modal-can-apply;
                        clicked => {
                            root.apply-modal-shortcut(root.active-modal-tool, root.active-modal-current-key);
                        }
                        Rectangle {
                            background: root.active-modal-can-apply ? (btn-modal-tick.has-hover ? (is-dark ? #383838 : #374151) : (is-dark ? #282828 : #1f2937)) : (is-dark ? #181818 : #f3f4f6);
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.active-modal-can-apply ? (is-dark ? #4f4f4f : #111827) : (is-dark ? #282828 : #e5e7eb);
                            Text {
                                text: "✓";
                                font-size: 15px;
                                font-weight: 700;
                                color: root.active-modal-can-apply ? #ffffff : (is-dark ? #4a4a4a : #9ca3af);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Modal Header Title
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.active-modal-tool-title != "" ? root.active-modal-tool-title : "Set Shortcut";
                            font-size: 13px;
                            font-weight: 700;
                            color: text-color;
                            horizontal-alignment: center;
                        }
                    }

                    // Close Button (Top-Right)
                    btn-modal-close := TouchArea {
                        width: 32px;
                        height: 32px;
                        clicked => { root.close-shortcut-modal(); }
                        Rectangle {
                            background: btn-modal-close.has-hover ? card-hover-bg : transparent;
                            border-radius: 6px;
                            Text {
                                text: "✕";
                                font-size: 13px;
                                font-weight: 600;
                                color: text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Middle: Live Shortcut Key Display Box (Automatically reads keypresses)
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        height: 52px;
                        background: card-hover-bg;
                        border-radius: 8px;
                        border-width: 1.5px;
                        border-color: root.active-modal-is-available ? (root.active-modal-can-apply ? accent : border-color) : danger-color;

                        HorizontalLayout {
                            alignment: center;
                            padding-left: 14px;
                            padding-right: 14px;

                            Text {
                                text: root.active-modal-current-key != "" ? root.active-modal-current-key : "Press shortcut keys...";
                                font-size: 17px;
                                font-weight: 700;
                                color: root.active-modal-current-key != "" ? text-color : text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "Press shortcut keys on your keyboard";
                        font-size: 11px;
                        color: text-muted;
                        horizontal-alignment: center;
                    }
                }

                // Bottom Status Line & "Use here" Button (Never overflows)
                HorizontalLayout {
                    alignment: space-between;
                    height: 30px;
                    spacing: 10px;

                    // Left: Status text with indicator dot
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.active-modal-is-available ? (is-dark ? #22c55e : #16a34a) : #737373;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.active-modal-status-text;
                                font-size: 12px;
                                font-weight: 600;
                                color: root.active-modal-is-available ? (is-dark ? #22c55e : #16a34a) : (is-dark ? #a3a3a3 : #737373);
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // Right: "Use here" override button
                    if (!root.active-modal-is-available && root.active-modal-show-override): btn-modal-override := TouchArea {
                        height: 28px;
                        clicked => {
                            root.active-modal-can-apply = true;
                            root.active-modal-is-available = true;
                            root.active-modal-status-text = "Overriding shortcut";
                        }
                        Rectangle {
                            background: btn-modal-override.has-hover ? card-hover-bg : (is-dark ? #2a2a2a : #e5e5e5);
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: border-color;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: "Use here";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: text-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
