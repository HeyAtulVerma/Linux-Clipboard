// MagicToys — Main Settings Window
// Clean PowerToys-inspired layout with Ople brand palette.

import { ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "MagicToys";
    icon: @image-url("../icon.png");


    preferred-width: 800px;
    preferred-height: 560px;
    background: bg-color;

    // Active section: 0=General, 1=Clipboard, 2=Emoji, 3=Text Extractor
    in-out property <int> active-section: 0;

    // Core properties (tools default to toggled off per user requirement)
    in-out property <string> theme-mode: "system";
    in-out property <bool> is-dark: true;
    in-out property <bool> enable-clipboard: false;
    in-out property <bool> enable-emoji: false;
    in-out property <bool> enable-ocr: false;

    in-out property <int> history-count: 0;
    in-out property <bool> clip-has-conflict: false;
    in-out property <bool> emoji-has-conflict: false;
    in-out property <bool> ocr-has-conflict: false;
    in-out property <string> accent-hex: "#f97316";

    // Design tokens — Ople black palette
    property <color> bg-color:       is-dark ? #0a0a0a : #f5f5f5;
    property <color> sidebar-bg:     is-dark ? #111111 : #ebebeb;
    property <color> card-bg:        is-dark ? #161616 : #ffffff;
    property <color> card-hover-bg:  is-dark ? #1e1e1e : #f0f0f0;
    property <color> text-color:     is-dark ? #f5f5f5 : #111111;
    property <color> text-muted:     is-dark ? #737373 : #737373;
    property <color> border-color:   is-dark ? #1f1f1f : #e0e0e0;
    property <color> danger-color:   #ef4444;

    // Accent — resolved from hex string (default Ople orange, user-switchable)
    property <color> accent: accent-hex == "#f97316" ? #f97316
        : accent-hex == "#3b82f6" ? #3b82f6
        : accent-hex == "#8b5cf6" ? #8b5cf6
        : accent-hex == "#22c55e" ? #22c55e
        : accent-hex == "#f43f5e" ? #f43f5e
        : accent-hex == "#06b6d4" ? #06b6d4
        : #f97316;

    // Callbacks
    callback change-theme(string);
    callback change-accent(string);
    callback toggle-clipboard(bool);
    callback toggle-emoji(bool);
    callback toggle-ocr(bool);
    callback fix-single-shortcut(string);
    callback clear-history();
    callback open-url(string);


    // ── Root layout ──────────────────────────────────────
    HorizontalLayout {
        spacing: 0;

        // ── SIDEBAR ─────────────────────────────────────
        Rectangle {
            width: 200px;
            background: sidebar-bg;
            border-width: 1px;
            border-color: border-color;
            // Visible only on the right edge (simulate right-border-only)


            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 16px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;

                // Brand header
                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 20px;
                    padding-left: 4px;

                    Image {
                        source: @image-url("../icon.png");
                        width: 44px;
                        height: 44px;
                    }



                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "MagicToys";
                            font-size: 15px;
                            font-weight: 700;
                            color: text-color;
                        }

                        Text {
                            text: "by Ople";
                            font-size: 12px;
                            color: accent;
                        }
                    }
                }

                // NAV ITEM helper — General
                nav-general := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 0; }
                    Rectangle {
                        background: root.active-section == 0 ? accent : (nav-general.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "General";
                                font-size: 14px;
                                font-weight: root.active-section == 0 ? 700 : 400;
                                color: root.active-section == 0 ? #ffffff : text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                nav-clipboard := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 1; }
                    Rectangle {
                        background: root.active-section == 1 ? accent : (nav-clipboard.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "Clipboard";
                                font-size: 14px;
                                font-weight: root.active-section == 1 ? 700 : 400;
                                color: root.active-section == 1 ? #ffffff : text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                nav-emoji := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 2; }
                    Rectangle {
                        background: root.active-section == 2 ? accent : (nav-emoji.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "Emoji Picker";
                                font-size: 14px;
                                font-weight: root.active-section == 2 ? 700 : 400;
                                color: root.active-section == 2 ? #ffffff : text-color;

                                vertical-alignment: center;
                            }
                        }
                    }
                }

                nav-ocr := TouchArea {
                    height: 38px;
                    clicked => { root.active-section = 3; }
                    Rectangle {
                        background: root.active-section == 3 ? accent : (nav-ocr.has-hover ? card-hover-bg : transparent);
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text {
                                text: "Text Extractor";
                                font-size: 14px;
                                font-weight: root.active-section == 3 ? 700 : 400;
                                color: root.active-section == 3 ? #ffffff : text-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Spacer pushes version badge down to stick as a footer
                Rectangle {
                    vertical-stretch: 1;
                }

                // Version badge: v0.0.3 with green Beta pill (sticking to bottom footer)
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    height: 24px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "v0.0.3";
                            font-size: 13px;
                            font-weight: 500;
                            color: text-muted;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        background: rgba(34, 197, 94, 0.15);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: rgba(34, 197, 94, 0.3);
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Beta";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #22c55e;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

            }

        }

        // ── CONTENT AREA ─────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0;

            // Topbar — section title only; OS provides the window close/min/max buttons
            Rectangle {
                height: 46px;
                background: card-bg;
                border-width: 1px;
                border-color: border-color;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;

                    Text {
                        text: root.active-section == 0 ? "General"
                            : root.active-section == 1 ? "Clipboard History"
                            : root.active-section == 2 ? "Emoji Picker"
                            : "Text Extractor (OCR)";
                        font-size: 15px;
                        font-weight: 600;
                        color: text-color;
                        vertical-alignment: center;
                    }
                }
            }

            // Scrollable content
            ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;

                    // ═══════════════════════════════
                    // SECTION 0: GENERAL
                    // ═══════════════════════════════
                    if (root.active-section == 0): VerticalLayout {
                        spacing: 12px;

                        // Theme card
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                // Row: label + pill selector
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Appearance";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Choose light, dark, or follow system theme";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 30px;

                                        TouchArea {
                                            width: 64px;
                                            clicked => { root.change-theme("system"); }
                                            Rectangle {
                                                background: root.theme-mode == "system" ? accent : card-hover-bg;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: root.theme-mode == "system" ? accent : border-color;
                                                Text {
                                                    text: "Auto";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: root.theme-mode == "system" ? #ffffff : text-muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            width: 56px;
                                            clicked => { root.change-theme("dark"); }
                                            Rectangle {
                                                background: root.theme-mode == "dark" ? accent : card-hover-bg;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: root.theme-mode == "dark" ? accent : border-color;
                                                Text {
                                                    text: "Dark";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: root.theme-mode == "dark" ? #ffffff : text-muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            width: 56px;
                                            clicked => { root.change-theme("light"); }
                                            Rectangle {
                                                background: root.theme-mode == "light" ? accent : card-hover-bg;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: root.theme-mode == "light" ? accent : border-color;
                                                Text {
                                                    text: "Light";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: root.theme-mode == "light" ? #ffffff : text-muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Divider
                                Rectangle {
                                    height: 1px;
                                    background: border-color;
                                }

                                // Row: Accent color swatches
                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Accent Color";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Active color used across the interface";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        // Orange (Ople default)
                                        swatch-orange := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#f97316"); }
                                            Rectangle {
                                                background: #f97316;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#f97316" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Blue
                                        swatch-blue := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#3b82f6"); }
                                            Rectangle {
                                                background: #3b82f6;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#3b82f6" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Violet
                                        swatch-violet := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#8b5cf6"); }
                                            Rectangle {
                                                background: #8b5cf6;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#8b5cf6" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Green
                                        swatch-green := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#22c55e"); }
                                            Rectangle {
                                                background: #22c55e;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#22c55e" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Rose
                                        swatch-rose := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#f43f5e"); }
                                            Rectangle {
                                                background: #f43f5e;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#f43f5e" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                        // Cyan
                                        swatch-cyan := TouchArea {
                                            width: 24px;
                                            height: 24px;
                                            clicked => { root.change-accent("#06b6d4"); }
                                            Rectangle {
                                                background: #06b6d4;
                                                border-radius: 12px;
                                                border-width: root.accent-hex == "#06b6d4" ? 2px : 0px;
                                                border-color: text-color;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Flexible spacer positioning the About card as a footer card
                        Rectangle {
                            height: 220px;
                        }


                        // About card: MagicToys Open-Source project by Ople with Contribute button
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;


                            HorizontalLayout {
                                padding: 16px;
                                spacing: 14px;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: "MagicToys";
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: text-color;
                                    }

                                    Text {
                                        text: "Open-Source project by Ople";
                                        font-size: 13px;
                                        color: text-muted;
                                    }
                                }

                                contribute-btn := TouchArea {
                                    width: 108px;
                                    height: 32px;
                                    clicked => { root.open-url("https://github.com"); }

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: contribute-btn.has-hover ? accent.darker(0.1) : accent;
                                        border-radius: 6px;

                                        HorizontalLayout {
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Contribute ↗";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                    }



                    // ═══════════════════════════════
                    // SECTION 1: CLIPBOARD
                    // ═══════════════════════════════
                    if (root.active-section == 1): VerticalLayout {
                        spacing: 12px;

                        // Tool enable card (with conflict border)
                        Rectangle {
                            background: (root.enable-clipboard && root.clip-has-conflict) ? (is-dark ? #1a0d0d : #fff5f5) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-clipboard && root.clip-has-conflict) ? 1.5px : 1px;
                            border-color: (root.enable-clipboard && root.clip-has-conflict) ? danger-color : border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                // Toggle row
                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Clipboard History";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Monitor clipboard changes — shortcut: Alt + V";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    // Toggle switch
                                    toggle-clip := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.enable-clipboard = !root.enable-clipboard;
                                            root.toggle-clipboard(root.enable-clipboard);
                                        }
                                        Rectangle {
                                            background: root.enable-clipboard ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.enable-clipboard ? accent : border-color;
                                            Rectangle {
                                                x: root.enable-clipboard ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                // Shortcut badge row
                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: "Global Shortcut";
                                        font-size: 13px;
                                        color: text-muted;
                                        vertical-alignment: center;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        Rectangle {
                                            background: card-hover-bg;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: border-color;
                                            height: 22px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: "Alt + V";
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: accent;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Fix shortcut button — only if conflict
                                        if (root.enable-clipboard && root.clip-has-conflict): fix-clip := TouchArea {
                                            width: 90px;
                                            height: 22px;
                                            clicked => { root.fix-single-shortcut("toggle"); }
                                            Rectangle {
                                                background: fix-clip.has-hover ? #dc2626 : danger-color;
                                                border-radius: 4px;
                                                Text {
                                                    text: "Fix Shortcut";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Conflict warning — only if conflict
                                if (root.enable-clipboard && root.clip-has-conflict): Text {
                                    text: "Shortcut conflict detected with system keybindings";
                                    font-size: 13px;
                                    color: danger-color;
                                }
                            }
                        }

                        // History storage card
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Saved Items";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: text-color;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.history-count + " clips";
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: accent;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: border-color;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Clear History";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: danger-color;
                                        }

                                        Text {
                                            text: "Permanently delete all stored clips";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    clr-btn := TouchArea {
                                        width: 76px;
                                        height: 28px;
                                        clicked => { root.clear-history(); }
                                        Rectangle {
                                            background: clr-btn.has-hover ? danger-color : card-hover-bg;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: clr-btn.has-hover ? danger-color : danger-color;
                                            Text {
                                                text: "Clear All";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: clr-btn.has-hover ? #ffffff : danger-color;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ═══════════════════════════════
                    // SECTION 2: EMOJI
                    // ═══════════════════════════════
                    if (root.active-section == 2): VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            background: (root.enable-emoji && root.emoji-has-conflict) ? (is-dark ? #1a0d0d : #fff5f5) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-emoji && root.emoji-has-conflict) ? 1.5px : 1px;
                            border-color: (root.enable-emoji && root.emoji-has-conflict) ? danger-color : border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Emoji Picker";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Enable emoji picker tab — shortcut: Alt + .";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    toggle-emoji-sw := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.enable-emoji = !root.enable-emoji;
                                            root.toggle-emoji(root.enable-emoji);
                                        }
                                        Rectangle {
                                            background: root.enable-emoji ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.enable-emoji ? accent : border-color;
                                            Rectangle {
                                                x: root.enable-emoji ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Global Shortcut";
                                        font-size: 13px;
                                        color: text-muted;
                                        vertical-alignment: center;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            background: card-hover-bg;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: border-color;
                                            height: 22px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: "Alt + .";
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: accent;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if (root.enable-emoji && root.emoji-has-conflict): fix-emoji := TouchArea {
                                            width: 90px;
                                            height: 22px;
                                            clicked => { root.fix-single-shortcut("emoji"); }
                                            Rectangle {
                                                background: fix-emoji.has-hover ? #dc2626 : danger-color;
                                                border-radius: 4px;
                                                Text {
                                                    text: "Fix Shortcut";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                if (root.enable-emoji && root.emoji-has-conflict): Text {
                                    text: "Shortcut conflict detected with system keybindings";
                                    font-size: 13px;
                                    color: danger-color;
                                }
                            }
                        }
                    }

                    // ═══════════════════════════════
                    // SECTION 3: TEXT EXTRACTOR
                    // ═══════════════════════════════
                    if (root.active-section == 3): VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            background: (root.enable-ocr && root.ocr-has-conflict) ? (is-dark ? #1a0d0d : #fff5f5) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-ocr && root.ocr-has-conflict) ? 1.5px : 1px;
                            border-color: (root.enable-ocr && root.ocr-has-conflict) ? danger-color : border-color;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Text Extractor (OCR)";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: text-color;
                                        }

                                        Text {
                                            text: "Capture text from screen region — shortcut: Alt + Shift + T";
                                            font-size: 13px;
                                            color: text-muted;
                                        }
                                    }

                                    toggle-ocr-sw := TouchArea {
                                        width: 44px;
                                        height: 24px;
                                        clicked => {
                                            root.enable-ocr = !root.enable-ocr;
                                            root.toggle-ocr(root.enable-ocr);
                                        }
                                        Rectangle {
                                            background: root.enable-ocr ? accent : card-hover-bg;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: root.enable-ocr ? accent : border-color;
                                            Rectangle {
                                                x: root.enable-ocr ? 22px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Global Shortcut";
                                        font-size: 13px;
                                        color: text-muted;
                                        vertical-alignment: center;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            background: card-hover-bg;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: border-color;
                                            height: 22px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: "Alt + Shift + T";
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    color: accent;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if (root.enable-ocr && root.ocr-has-conflict): fix-ocr := TouchArea {
                                            width: 90px;
                                            height: 22px;
                                            clicked => { root.fix-single-shortcut("ocr"); }
                                            Rectangle {
                                                background: fix-ocr.has-hover ? #dc2626 : danger-color;
                                                border-radius: 4px;
                                                Text {
                                                    text: "Fix Shortcut";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                if (root.enable-ocr && root.ocr-has-conflict): Text {
                                    text: "Shortcut conflict detected with system keybindings";
                                    font-size: 13px;
                                    color: danger-color;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
