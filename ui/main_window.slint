// Linux Clipboard Standalone Main Window with 4 Categorized Sections

import { ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Linux Clipboard Preferences";
    icon: @image-url("../icon_rounded.png");
    width: 580px;
    height: 450px;
    background: bg-color;

    // Active Section index: 0 = General, 1 = Clipboard, 2 = Emoji, 3 = Text Extractor
    in-out property <int> active-section: 0;

    // Theme & Styling properties
    in-out property <string> theme-mode: "system";
    in-out property <bool> is-dark: true;
    in-out property <bool> enable-clipboard: true;
    in-out property <bool> enable-emoji: true;
    in-out property <bool> enable-ocr: true;
    in-out property <int> history-count: 0;
    in-out property <bool> clip-has-conflict: false;
    in-out property <bool> emoji-has-conflict: false;
    in-out property <bool> ocr-has-conflict: false;

    // Color definitions
    in-out property <color> bg-color: is-dark ? #0f131d : #f8f9fa;
    in-out property <color> card-bg: is-dark ? #181d2a : #ffffff;
    in-out property <color> card-hover-bg: is-dark ? #222838 : #f1f3f5;
    in-out property <color> text-color: is-dark ? #f1f3f5 : #1a1d20;
    in-out property <color> text-secondary: is-dark ? #8b95a5 : #6c757d;
    in-out property <color> border-color: is-dark ? #2a3142 : #dee2e6;
    in-out property <color> accent-color: #3b82f6;

    // Callbacks
    callback change-theme(string);
    callback toggle-clipboard(bool);
    callback toggle-emoji(bool);
    callback toggle-ocr(bool);
    callback fix-single-shortcut(string);
    callback clear-history();
    callback close-window();

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Custom Titlebar Header
        Rectangle {
            height: 44px;
            background: card-bg;
            border-width: 1px;
            border-color: border-color;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;

                    Image {
                        source: @image-url("../icon_rounded.png");
                        width: 20px;
                        height: 20px;
                    }

                    Text {
                        text: "Preferences";
                        font-size: 14px;
                        font-weight: 700;
                        color: text-color;
                        vertical-alignment: center;
                    }
                }

                // Close Button
                close-btn := TouchArea {
                    width: 26px;
                    height: 26px;
                    clicked => { root.close-window(); }

                    Rectangle {
                        background: close-btn.has-hover ? #e81123 : transparent;
                        border-radius: 6px;
                        Text {
                            text: "✕";
                            font-size: 12px;
                            color: close-btn.has-hover ? #ffffff : text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Main Sidebar + Content Body Layout
        HorizontalLayout {
            spacing: 0;

            // ==========================================
            // LEFT SIDEBAR (4 Options)
            // ==========================================
            Rectangle {
                width: 160px;
                background: card-bg;
                border-width: 1px;
                border-color: border-color;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    alignment: start;

                    // Option 1: General
                    nav-general := TouchArea {
                        height: 36px;
                        clicked => { root.active-section = 0; }

                        Rectangle {
                            background: root.active-section == 0 ? accent-color : (nav-general.has-hover ? card-hover-bg : transparent);
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;

                                Text {
                                    text: "⚙️ General";
                                    font-size: 12px;
                                    font-weight: root.active-section == 0 ? 700 : 500;
                                    color: root.active-section == 0 ? #ffffff : text-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Option 2: Clipboard
                    nav-clip := TouchArea {
                        height: 36px;
                        clicked => { root.active-section = 1; }

                        Rectangle {
                            background: root.active-section == 1 ? accent-color : (nav-clip.has-hover ? card-hover-bg : transparent);
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;

                                Text {
                                    text: "📋 Clipboard";
                                    font-size: 12px;
                                    font-weight: root.active-section == 1 ? 700 : 500;
                                    color: root.active-section == 1 ? #ffffff : text-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Option 3: Emoji
                    nav-emoji := TouchArea {
                        height: 36px;
                        clicked => { root.active-section = 2; }

                        Rectangle {
                            background: root.active-section == 2 ? accent-color : (nav-emoji.has-hover ? card-hover-bg : transparent);
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;

                                Text {
                                    text: "😊 Emoji";
                                    font-size: 12px;
                                    font-weight: root.active-section == 2 ? 700 : 500;
                                    color: root.active-section == 2 ? #ffffff : text-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Option 4: Text Extractor
                    nav-ocr := TouchArea {
                        height: 36px;
                        clicked => { root.active-section = 3; }

                        Rectangle {
                            background: root.active-section == 3 ? accent-color : (nav-ocr.has-hover ? card-hover-bg : transparent);
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;

                                Text {
                                    text: "🔍 Text Extractor";
                                    font-size: 12px;
                                    font-weight: root.active-section == 3 ? 700 : 500;
                                    color: root.active-section == 3 ? #ffffff : text-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // RIGHT CONTENT PANEL
            // ==========================================
            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    alignment: start;

                    // SECTION 1: GENERAL (Theme Settings & App Info)
                    if (root.active-section == 0) : VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "⚙️ General Settings";
                            font-size: 15px;
                            font-weight: 700;
                            color: text-color;
                        }

                        // Theme Mode Card
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;

                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: "Color Theme Mode";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: text-color;
                                    }
                                    Text {
                                        text: "Select light, dark, or automatically match system desktop appearance.";
                                        font-size: 11px;
                                        color: text-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 34px;

                                    // Auto / System
                                    TouchArea {
                                        clicked => { root.change-theme("system"); }
                                        Rectangle {
                                            background: root.theme-mode == "system" ? accent-color : card-hover-bg;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: root.theme-mode == "system" ? accent-color : border-color;
                                            Text {
                                                text: "💻 Auto (System)";
                                                color: root.theme-mode == "system" ? #ffffff : text-color;
                                                font-size: 11px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Dark
                                    TouchArea {
                                        clicked => { root.change-theme("dark"); }
                                        Rectangle {
                                            background: root.theme-mode == "dark" ? accent-color : card-hover-bg;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: root.theme-mode == "dark" ? accent-color : border-color;
                                            Text {
                                                text: "🌙 Dark";
                                                color: root.theme-mode == "dark" ? #ffffff : text-color;
                                                font-size: 11px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Light
                                    TouchArea {
                                        clicked => { root.change-theme("light"); }
                                        Rectangle {
                                            background: root.theme-mode == "light" ? accent-color : card-hover-bg;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: root.theme-mode == "light" ? accent-color : border-color;
                                            Text {
                                                text: "☀️ Light";
                                                color: root.theme-mode == "light" ? #ffffff : text-color;
                                                font-size: 11px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // App Info Card
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Linux Clipboard";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: text-color;
                                    }
                                    Text {
                                        text: "by Ople (lincb.ople.in)";
                                        font-size: 11px;
                                        color: accent-color;
                                        font-weight: 600;
                                    }
                                }

                                Text {
                                    text: "Native Rust + Slint + SQLite Clipboard Manager for Linux (X11 & Wayland).";
                                    font-size: 11px;
                                    color: text-secondary;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Version: v0.0.3 (Beta)";
                                    font-size: 11px;
                                    color: text-secondary;
                                }
                            }
                        }
                    }

                    // SECTION 2: CLIPBOARD
                    if (root.active-section == 1) : VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "📋 Clipboard Settings & Hotkey";
                            font-size: 15px;
                            font-weight: 700;
                            color: text-color;
                        }

                        // Shortcut & Registration Card
                        Rectangle {
                            background: (root.enable-clipboard && root.clip-has-conflict) ? (is-dark ? #2c1618 : #fef2f2) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-clipboard && root.clip-has-conflict) ? 2px : 1px;
                            border-color: (root.enable-clipboard && root.clip-has-conflict) ? #ef4444 : border-color;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: "Enable Clipboard History Tool";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Monitor clipboard changes and enable Alt + V drawer";
                                            font-size: 11px;
                                            color: text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    TouchArea {
                                        width: 50px;
                                        height: 26px;
                                        clicked => {
                                            root.enable-clipboard = !root.enable-clipboard;
                                            root.toggle-clipboard(root.enable-clipboard);
                                        }
                                        Rectangle {
                                            background: root.enable-clipboard ? accent-color : card-hover-bg;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: root.enable-clipboard ? accent-color : border-color;

                                            Rectangle {
                                                x: root.enable-clipboard ? 26px : 2px;
                                                y: 2px;
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                if (root.enable-clipboard && root.clip-has-conflict) : Text {
                                    text: "⚠️ Shortcut conflict detected with system keybindings";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #ef4444;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Global Shortcut";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Open history drawer to paste text or images";
                                            font-size: 11px;
                                            color: text-secondary;
                                        }
                                    }
                                    Rectangle {
                                        background: card-hover-bg;
                                        border-radius: 4px;
                                        height: 24px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: "Alt + V";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: accent-color;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if (root.enable-clipboard && root.clip-has-conflict) : fix-clip-btn := TouchArea {
                                    height: 30px;
                                    clicked => { root.fix-single-shortcut("toggle"); }
                                    Rectangle {
                                        background: fix-clip-btn.has-hover ? #ef4444 : #dc2626;
                                        border-radius: 6px;
                                        Text {
                                            text: "🔧 Fix Shortcut";
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Storage & Clear History Card
                        Rectangle {
                            background: card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: border-color;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Saved History Snippets";
                                        font-size: 12px;
                                        color: text-color;
                                    }
                                    Text {
                                        text: root.history-count + " items";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Clear History Database";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: #e81123;
                                        }
                                        Text {
                                            text: "Permanently delete stored clips and images";
                                            font-size: 11px;
                                            color: text-secondary;
                                        }
                                    }

                                    clear-btn := TouchArea {
                                        width: 85px;
                                        height: 28px;
                                        clicked => { root.clear-history(); }
                                        Rectangle {
                                            background: clear-btn.has-hover ? #e81123 : card-hover-bg;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: clear-btn.has-hover ? #e81123 : border-color;
                                            Text {
                                                text: "Clear All";
                                                color: clear-btn.has-hover ? #ffffff : #e81123;
                                                font-size: 11px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // SECTION 3: EMOJI
                    if (root.active-section == 2) : VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "😊 Emoji Picker Settings & Hotkey";
                            font-size: 15px;
                            font-weight: 700;
                            color: text-color;
                        }

                        Rectangle {
                            background: (root.enable-emoji && root.emoji-has-conflict) ? (is-dark ? #2c1618 : #fef2f2) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-emoji && root.emoji-has-conflict) ? 2px : 1px;
                            border-color: (root.enable-emoji && root.emoji-has-conflict) ? #ef4444 : border-color;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: "Enable Emoji Picker Tool";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Enable emoji tab and Alt + . quick shortcut";
                                            font-size: 11px;
                                            color: text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    TouchArea {
                                        width: 50px;
                                        height: 26px;
                                        clicked => {
                                            root.enable-emoji = !root.enable-emoji;
                                            root.toggle-emoji(root.enable-emoji);
                                        }
                                        Rectangle {
                                            background: root.enable-emoji ? accent-color : card-hover-bg;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: root.enable-emoji ? accent-color : border-color;

                                            Rectangle {
                                                x: root.enable-emoji ? 26px : 2px;
                                                y: 2px;
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                if (root.enable-emoji && root.emoji-has-conflict) : Text {
                                    text: "⚠️ Shortcut conflict detected with system keybindings";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #ef4444;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Global Shortcut";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Open emoji and symbol picker grid";
                                            font-size: 11px;
                                            color: text-secondary;
                                        }
                                    }
                                    Rectangle {
                                        background: card-hover-bg;
                                        border-radius: 4px;
                                        height: 24px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: "Alt + .";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: accent-color;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if (root.enable-emoji && root.emoji-has-conflict) : fix-emoji-btn := TouchArea {
                                    height: 30px;
                                    clicked => { root.fix-single-shortcut("emoji"); }
                                    Rectangle {
                                        background: fix-emoji-btn.has-hover ? #ef4444 : #dc2626;
                                        border-radius: 6px;
                                        Text {
                                            text: "🔧 Fix Shortcut";
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // SECTION 4: TEXT EXTRACTOR (OCR)
                    if (root.active-section == 3) : VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "🔍 Screen Text Extractor (OCR)";
                            font-size: 15px;
                            font-weight: 700;
                            color: text-color;
                        }

                        Rectangle {
                            background: (root.enable-ocr && root.ocr-has-conflict) ? (is-dark ? #2c1618 : #fef2f2) : card-bg;
                            border-radius: 8px;
                            border-width: (root.enable-ocr && root.ocr-has-conflict) ? 2px : 1px;
                            border-color: (root.enable-ocr && root.ocr-has-conflict) ? #ef4444 : border-color;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: "Enable OCR Extractor";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Capture text from screen region directly to clipboard";
                                            font-size: 11px;
                                            color: text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    TouchArea {
                                        width: 50px;
                                        height: 26px;
                                        clicked => {
                                            root.enable-ocr = !root.enable-ocr;
                                            root.toggle-ocr(root.enable-ocr);
                                        }
                                        Rectangle {
                                            background: root.enable-ocr ? accent-color : card-hover-bg;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: root.enable-ocr ? accent-color : border-color;

                                            Rectangle {
                                                x: root.enable-ocr ? 26px : 2px;
                                                y: 2px;
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: #ffffff;
                                            }
                                        }
                                    }
                                }

                                if (root.enable-ocr && root.ocr-has-conflict) : Text {
                                    text: "⚠️ Shortcut conflict detected with system keybindings";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #ef4444;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: "Global Shortcut";
                                            font-size: 12px;
                                            color: text-color;
                                        }
                                        Text {
                                            text: "Trigger screen region selection for text capture";
                                            font-size: 11px;
                                            color: text-secondary;
                                        }
                                    }
                                    Rectangle {
                                        background: card-hover-bg;
                                        border-radius: 4px;
                                        height: 24px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: "Alt + Shift + T";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: accent-color;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if (root.enable-ocr && root.ocr-has-conflict) : fix-ocr-btn := TouchArea {
                                    height: 30px;
                                    clicked => { root.fix-single-shortcut("ocr"); }
                                    Rectangle {
                                        background: fix-ocr-btn.has-hover ? #ef4444 : #dc2626;
                                        border-radius: 6px;
                                        Text {
                                            text: "🔧 Fix Shortcut";
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
